# build artifacts
build/
# bin/ holds the compiled CLI (unipercept) plus its Nim source. Ignore the
# binary output, track the source. git cannot re-include a file under an
# excluded directory, so exclude the contents (not the dir) and negate sources.
/bin/*
!/bin/*.nim
libUniPercept.so
libUniPercept.so.*
libUniPercept.dylib
libUniPercept.a
*.o
*.obj
*.exe
*.dll
*.so
*.so.*
*.dylib
*.a
*.lib

# coverage
coverage/
lcov.info

# nim cache
nimcache/
rnimcache/
dnimcache/

# docs output
pages/
docs/
*.html
nimdoc.out.css

# python binding artifacts (sources tracked; generated + bundled lib not)
py/unipercept/_core.c
py/unipercept/*.so
py/unipercept/libUniPercept.so
py/dist/
py/build/
py/_nimsrc/
py/*.egg-info/
py/**/__pycache__/
py/.pytest_cache/

# c test/example binaries
tests/c/test_unipercept
examples/c/demo

# os / editor
.DS_Store
*~
.*.swp
*.dSYM

*.log
*.core

# nimib saves a page beside a compiled chapter; not a deliverable.
book/*.html

# nimibook build output. `docs` copies it to pages/, which is what ships.
book/__site/
